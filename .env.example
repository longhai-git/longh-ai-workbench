# ==========================================================================
# LongH AI Workbench - 生产环境配置
# 复制此文件为 .env 并修改实际值
# ==========================================================================

# --- 服务配置 ---
# 服务端口（容器内部端口，默认3001）
PORT=3001
# 运行环境 production | development
NODE_ENV=production

# --- 安全配置 ---
# JWT 密钥（请更改为随机字符串，至少32位）
# 可用命令生成: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-key-at-least-32-chars

# --- 数据库配置 ---
# 本地开发: SQLite 数据库文件路径（留空则使用默认路径）
DB_PATH=./data/workbench.db

# 生产部署: Turso 远程数据库（与 DB_PATH 二选一）
# 注册地址: https://turso.tech （免费9GB存储，无需信用卡）
# 在 Turso 控制台创建数据库后获取以下两个值
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- 文件上传配置 ---
# 上传文件存储目录（本地模式）
UPLOAD_DIR=./data/uploads

# --- Volcengine Ark AI 配置 ---
# 火山引擎 Ark API Key
ARK_API_KEY=
# Ark 模型端点（如 doubao-pro-32k 等）
ARK_MODEL_ENDPOINT=
# 备选API地址（如使用代理）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# --- 前端配置 ---
# API基础路径（通过Nginx反代时通常为 /api）
VITE_API_BASE_URL=/api

# --- 密码找回：阿里云短信（不配置则验证码显示在页面上） ---
# 阿里云 AccessKey（建议使用仅授权短信服务的子账号 AK）
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信签名名称（需在阿里云短信控制台审核通过）
ALIYUN_SMS_SIGN_NAME=
# 短信模板 CODE（如 SMS_123456789，模板内容需包含 ${code}）
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou

# --- 密码找回：SMTP 邮箱（不配置则验证码显示在页面上） ---
SMTP_HOST=
SMTP_PORT=465
# 465 端口用 true；25/587 端口用 false
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人，留空则默认使用 SMTP_USER
SMTP_FROM=
